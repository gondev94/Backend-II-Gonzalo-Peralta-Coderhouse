<link rel="stylesheet" href="/css/auth.css">

<div class="auth-container">
    <div class="auth-card">
        <h1>Crear Cuenta</h1>
        <p class="subtitle">Únete a nuestra comunidad</p>
        
        <!-- Botón de Google -->
        <a href="/api/sessions/google" class="btn-google">
            <svg viewBox="0 0 24 24" width="20" height="20">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Registrarse con Google
        </a>
        
        <div class="divider">
            <span>o</span>
        </div>
        
        <form id="registerForm" class="auth-form">
            <div class="form-row">
                <div class="form-group">
                    <label>Nombre</label>
                    <input type="text" name="first_name" id="first_name" required>
                </div>
                <div class="form-group">
                    <label>Apellido</label>
                    <input type="text" name="last_name" id="last_name" required>
                </div>
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" id="email" required>
            </div>
            <div class="form-group">
                <label>Contraseña</label>
                <input type="password" name="password" id="password" required minlength="6">
            </div>
            <button type="submit" class="btn btn-primary">Registrarse</button>
        </form>
        
        <div id="message" class="auth-message"></div>
        
        <p class="auth-links">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
    </div>
</div>

<style>
.btn-google {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 12px 20px;
    background: white;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    color: #333;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
    margin-bottom: 20px;
}

.btn-google:hover {
    background: #f5f5f5;
    border-color: #ccc;
}

.divider {
    display: flex;
    align-items: center;
    margin: 20px 0;
}

.divider::before,
.divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #e0e0e0;
}

.divider span {
    padding: 0 15px;
    color: #999;
    font-size: 14px;
}
</style>

<script>
document.getElementById('registerForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const first_name = document.getElementById('first_name').value;
    const last_name = document.getElementById('last_name').value;
    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;
    const messageDiv = document.getElementById('message');
    
    try {
        const res = await fetch('/api/sessions/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ first_name, last_name, email, password })
        });
        const data = await res.json();
        
        if (data.status === 'success') {
            messageDiv.className = 'auth-message success';
            messageDiv.textContent = '¡Cuenta creada! Redirigiendo...';
            setTimeout(() => window.location.href = '/products', 1500);
        } else {
            messageDiv.className = 'auth-message error';
            messageDiv.textContent = data.message || 'Error al registrar';
        }
    } catch (error) {
        messageDiv.className = 'auth-message error';
        messageDiv.textContent = 'Error de conexión';
    }
});
</script>
