<link rel="stylesheet" href="/css/auth.css">

<div class="auth-container" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
    <div class="auth-card">
        <h1>Nueva Contraseña</h1>
        <p class="subtitle">Ingresa tu nueva contraseña</p>
        
        <form id="resetForm" class="auth-form">
            <div class="form-group">
                <label>Nueva Contraseña</label>
                <input type="password" name="password" id="password" required minlength="6" placeholder="Mínimo 6 caracteres">
            </div>
            <div class="form-group">
                <label>Confirmar Contraseña</label>
                <input type="password" name="confirmPassword" id="confirmPassword" required minlength="6" placeholder="Repite la contraseña">
            </div>
            <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">Cambiar Contraseña</button>
        </form>
        
        <div id="message" class="auth-message"></div>
        
        <p class="auth-links">
            <a href="/login" style="color: #11998e;">Volver al Login</a>
        </p>
    </div>
</div>

<script>
const token = window.location.pathname.split('/').pop();

// Verificar token al cargar
(async () => {
    try {
        const res = await fetch(`/api/sessions/reset-password/${token}`);
        const data = await res.json();
        
        if (data.status !== 'success') {
            document.querySelector('.auth-card').innerHTML = `
                <h1>Enlace Inválido</h1>
                <p class="subtitle" style="color: #dc3545;">${data.message}</p>
                <p class="auth-links">
                    <a href="/forgot-password" style="color: #11998e;">Solicitar nuevo enlace</a>
                </p>
            `;
        }
    } catch (error) {
        console.error('Error verificando token:', error);
    }
})();

document.getElementById('resetForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    const messageDiv = document.getElementById('message');
    const btn = e.target.querySelector('button');
    
    if (password !== confirmPassword) {
        messageDiv.className = 'auth-message error';
        messageDiv.textContent = 'Las contraseñas no coinciden';
        return;
    }
    
    btn.disabled = true;
    btn.textContent = 'Procesando...';
    
    try {
        const res = await fetch(`/api/sessions/reset-password/${token}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password, confirmPassword })
        });
        const data = await res.json();
        
        messageDiv.className = 'auth-message ' + (data.status === 'success' ? 'success' : 'error');
        messageDiv.textContent = data.message;
        
        if (data.status === 'success') {
            setTimeout(() => {
                window.location.href = '/login';
            }, 2000);
        }
    } catch (error) {
        messageDiv.className = 'auth-message error';
        messageDiv.textContent = 'Error de conexión';
    }
    
    btn.disabled = false;
    btn.textContent = 'Cambiar Contraseña';
});
</script>
